generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LocationArea {
  JLT
  DIFC
  DOWNTOWN
  BUSINESS_BAY
  MARINA
  OTHER
}

enum BudgetRange {
  LOW
  MID
  HIGH
}

enum AccountTier {
  FREE
  PRO
}

enum DecisionAction {
  DIRECTIONS
  CALL
  ORDER
  SELECT
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  passwordHash       String?
  name               String?
  phoneNumber        String?
  googleId           String?      @unique
  locationArea       LocationArea @default(OTHER)
  cuisinePreferences String[]
  budgetRange        BudgetRange  @default(MID)
  dietary            String[]
  accountTier        AccountTier  @default(FREE)
  stripeCustomerId   String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  decisionSessions DecisionSession[]
  tasteProfile     UserTasteProfile?
}

model Restaurant {
  id              String       @id @default(cuid())
  name            String
  cuisineType     String
  area            LocationArea
  priceMin        Int
  priceMax        Int
  phone           String?
  googleMapsUrl   String?
  talabatUrl      String?
  noonUrl         String?
  deliverooUrl    String?
  isActive        Boolean      @default(true)
  isFeatured      Boolean      @default(false)
  tags            String[]
  ratingScore     Float        @default(0)
  averageCalories Int?

  // --- Google Places (populated by `npm run sync:places`) ---
  googlePlaceId  String?   @unique
  /// Places photo resource names ("places/{placeId}/photos/{photoId}"), max 6.
  /// Served to clients via the /api/photos proxy so the API key never ships.
  photoRefs      String[]
  lat            Float?
  lng            Float?
  googleRating   Float?
  /// Google `regularOpeningHours.periods` verbatim:
  /// [{ open: { day, hour, minute }, close?: { day, hour, minute } }].
  /// day is 0=Sunday..6=Saturday in the PLACE's local time (Asia/Dubai here).
  /// A period with no `close` means the place is open 24/7.
  /// Read through `isOpenNow()` in src/lib/hours.ts — never inline.
  openingHours   Json?
  googleSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyPicksAsResult1 DailyPick[] @relation("DailyPickResult1")
  dailyPicksAsResult2 DailyPick[] @relation("DailyPickResult2")
  dailyPicksAsResult3 DailyPick[] @relation("DailyPickResult3")
}

model DecisionSession {
  id               String          @id @default(cuid())
  userId           String?
  user             User?           @relation(fields: [userId], references: [id])
  promptText       String
  moodChipsUsed    String[]
  resultIds        String[]
  selectedResultId String?
  actionTaken      DecisionAction?
  createdAt        DateTime        @default(now())
}

model DailyPick {
  id         String     @id @default(cuid())
  date       DateTime   @unique
  themeLabel String
  result1Id  String
  result1    Restaurant @relation("DailyPickResult1", fields: [result1Id], references: [id])
  result2Id  String
  result2    Restaurant @relation("DailyPickResult2", fields: [result2Id], references: [id])
  result3Id  String
  result3    Restaurant @relation("DailyPickResult3", fields: [result3Id], references: [id])
  isLive     Boolean    @default(false)
  createdAt  DateTime   @default(now())
}

/// DecisionEngine v2 — learned cuisine affinity per user.
///
/// `weights` is a flat map of lowercased cuisine/tag -> float in [-5, 10],
/// updated by `applyTasteEvent()` in src/services/tasteProfile.ts. Stored as
/// Json rather than rows because it is always read and written whole.
model UserTasteProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weights   Json     @default("{}")
  updatedAt DateTime @updatedAt
}

/// DecisionEngine v2 — one row per engine invocation.
///
/// Kept deliberately denormalised: this is an audit/telemetry trail for tuning
/// the weights, not something the app reads back. `breakdown` holds the full
/// per-candidate component scores so a pick can be explained after the fact.
model DecisionLog {
  id           String   @id @default(cuid())
  userId       String?
  sessionId    String?
  /// { formatFilter, vibe, budget, lat, lng, dateISO, seed, candidateCount, relaxed[] }
  inputSummary Json
  /// [{ restaurantId, quality, taste, context, total, damping, reason }]
  breakdown    Json
  chosenIds    String[]
  radiusTier   String
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}
