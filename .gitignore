# Environment variables (never commit these)
.env
.env.local
.env.production
.env.*.local
server/.env
client/.env
mobile/.env

# Dependencies
node_modules/
*/node_modules/
**/node_modules/

# Build outputs
build/
dist/
client/dist/
server/dist/
mobile/.expo/
mobile/dist/

# Prisma
server/prisma/*.db
server/prisma/migrations/dev.db

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# TypeScript
*.tsbuildinfo

# Expo
mobile/.expo-shared/
mobile/web-build/

# Editor
.vscode/
.idea/

# Restaurant import pipeline working files.
# Candidate/approved files are one curation session's scratch, and rejected.json
# is a local memory of what a human has already declined — none of it is code.
server/imports/

# taste-skill working output (screenshots, inspector reports)
.taste-skill/

# scratch assets for review artifacts
client/.artifact-assets/

# artifact review builds (published to claude.ai, never deployed)
client/dist-artifact/
