{
  "expo": {
    "name": "Jou3an",
    "slug": "jou3an",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "jou3an",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080808",
    "developmentClient": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jou3an.app",
      "buildNumber": "3",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jou3an.app",
      "adaptiveIcon": {
        "backgroundColor": "#E8272A",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Jou3an to use your location to find restaurants near you."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080808",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0c837d8b-9ee1-4702-b22e-1c2b537477a5"
      }
    }
  }
}
